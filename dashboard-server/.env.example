# TakeoverBench configuration
# Copy this file to .env and adjust for your setup.

# CARLA server address
CARLA_HOST=127.0.0.1
CARLA_PORT=2000

# Flask dashboard
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# MQTT broker (embedded broker runs on 127.0.0.1:1883 by default)
# External HMI devices can connect here
# MQTT_HOST=0.0.0.0
# MQTT_PORT=1883

# CARLA Python API (.egg or .whl from your CARLA install)
# Find it in: <CARLA_DIR>\PythonAPI\carla\dist\
# IMPORTANT: CARLA 0.9.16 requires Python 3.7–3.12. Python 3.13+ is NOT supported.
# The wheel filename indicates the Python version (e.g. cp312 = Python 3.12).
CARLA_PYTHON_EGG=C:\CARLA_0.9.16\PythonAPI\carla\dist\carla-0.9.16-cp312-cp312-win_amd64.whl

MQTT_PORT_KILL_MODE=ask

# Optional: URL encoded in the QR code printed on session reports.
# Leave empty to auto-use this server's /results page on the LAN
# (http://<LAN-IP>:<FLASK_PORT>/results). If participants cannot reach the
# LAN address, set this to any reachable URL.
# REPORT_QR_URL=https://example.com/takeoverbench-results
